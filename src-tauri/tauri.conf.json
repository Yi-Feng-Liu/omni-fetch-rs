{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omni Fetch",
  "version": "0.2.2",
  "identifier": "app.omnifetch.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Omni Fetch",
        "width": 1120,
        "height": 820,
        "minWidth": 760,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/gallery-dl",
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["TradChinese", "English"]
      }
    },
    "resources": ["third-party/README.md"]
  }
}
